{
  "description": "Capture stable Codex hook events and restore Jev-selected context after compaction.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/codex/codex-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\codex\\codex-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/codex/codex-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\codex\\codex-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/codex/codex-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\codex\\codex-hook.mjs\"",
            "timeout": 120,
            "statusMessage": "Restoring Jev-selected context",
            "additionalContextLimit": 20000
          }
        ]
      }
    ]
  }
}
